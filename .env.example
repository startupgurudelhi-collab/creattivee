# =========================================================
# Creattivee Digital Agency - Environment Variables Configuration
# =========================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted (e.g. https://creattivee.com)
APP_URL="MY_APP_URL"

# =========================================================
# PostgreSQL Database Configuration (Coolify, Docker, Neon, Supabase)
# =========================================================
# Option A: Full Connection String (Recommended for Coolify / Supabase / Neon)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/creattivee_db"

# Option B: Individual PostgreSQL parameters
DB_TYPE="postgres"
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="postgres"
DB_PASSWORD="your_password"
DB_NAME="creattivee_db"

# Alternative Standard PostgreSQL Environment Variables (Coolify native):
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_password
# POSTGRES_DB=creattivee_db
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432

# Option C: SSL Mode for Cloud PostgreSQL (e.g. Neon, Supabase, AWS RDS)
# PGSSLMODE="require"
